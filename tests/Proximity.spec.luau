--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Proximity = require(Shared.Proximity)
local Config = require(Shared.data.Config)
local Home = require(Shared.data.Home)
local Visiting = require(Shared.data.Visiting)
local F = require(script.Parent.Fixtures)

local range = Config.PeddlerInteractDistance + Config.PeddlerDistanceSlack -- what PeddlerBuy allows
local half = Home.PlotCells * Home.PlotCellStuds * F.half -- half the plot's side
local waveRange = Visiting.WaveDistance
local nan = F.zero / F.zero
local inf = F.one / F.zero

describe("Proximity.Within (PeddlerBuy's reach)", function()
	it("accepts a character at the ship and one exactly at the allowed distance", function()
		expect(Proximity.Within(F.zero, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(true)
		expect(Proximity.Within(range, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(true)
		expect(Proximity.Within(F.zero, F.zero, -range, F.zero, F.zero, F.zero, range)).toEqual(true)
	end)
	it("refuses one stud past it, on any axis", function()
		expect(Proximity.Within(range + F.one, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(false)
		expect(Proximity.Within(F.zero, range + F.one, F.zero, F.zero, F.zero, F.zero, range)).toEqual(false)
		expect(Proximity.Within(F.zero, F.zero, range + F.one, F.zero, F.zero, F.zero, range)).toEqual(false)
	end)
	it("measures all three axes together", function()
		expect(Proximity.Within(range, range, range, F.zero, F.zero, F.zero, range)).toEqual(false)
		expect(Proximity.Within(range * F.half, range * F.half, F.zero, F.zero, F.zero, F.zero, range)).toEqual(true)
	end)
	it("refuses a position or target that is not a number", function()
		expect(Proximity.Within(nan, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(false)
		expect(Proximity.Within(F.zero, F.zero, F.zero, F.zero, nan, F.zero, range)).toEqual(false)
		expect(Proximity.Within(inf, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(false)
		expect(Proximity.Within(-inf, F.zero, F.zero, F.zero, F.zero, F.zero, range)).toEqual(false)
	end)
	it("refuses everything when the range itself is not a number", function()
		expect(Proximity.Within(F.zero, F.zero, F.zero, F.zero, F.zero, F.zero, nan)).toEqual(false)
	end)
end)

describe("Proximity.FlatGapToSquare and WithinSquare (Wave's reach)", function()
	it("is zero anywhere on the plot, edges included", function()
		expect(Proximity.FlatGapToSquare(F.zero, F.zero, F.zero, F.zero, half)).toEqual(F.zero)
		expect(Proximity.FlatGapToSquare(half, -half, F.zero, F.zero, half)).toEqual(F.zero)
	end)
	it("is the distance to the nearest edge, wherever the plot stands", function()
		local gap = Proximity.FlatGapToSquare(half + waveRange, F.zero, F.zero, F.zero, half)
		expect(gap).toEqual(waveRange)
		local shifted = Proximity.FlatGapToSquare(half + waveRange + range, range, range, range, half)
		expect(shifted).toEqual(waveRange)
	end)
	it("uses the corner for a diagonal gap", function()
		local gap = Proximity.FlatGapToSquare(half + waveRange, half + waveRange, F.zero, F.zero, half)
		expect(gap).toBeClose(waveRange * math.sqrt(F.two), F.tolerance)
	end)
	it("accepts up to WaveDistance from the edge and refuses past it", function()
		expect(Proximity.WithinSquare(half + waveRange, F.zero, F.zero, F.zero, half, waveRange)).toEqual(true)
		expect(Proximity.WithinSquare(half + waveRange + F.one, F.zero, F.zero, F.zero, half, waveRange)).toEqual(false)
		expect(Proximity.WithinSquare(F.zero, -half - waveRange - F.one, F.zero, F.zero, half, waveRange)).toEqual(false)
		expect(Proximity.WithinSquare(half + waveRange, half + waveRange, F.zero, F.zero, half, waveRange)).toEqual(false)
	end)
	it("accepts a visitor beside the plot's corner who is within reach on both sides", function()
		local near = half + waveRange * F.half
		expect(Proximity.WithinSquare(near, near, F.zero, F.zero, half, waveRange)).toEqual(true)
	end)
	it("refuses a position that is not a number", function()
		expect(Proximity.WithinSquare(nan, F.zero, F.zero, F.zero, half, waveRange)).toEqual(false)
		expect(Proximity.WithinSquare(F.zero, nan, F.zero, F.zero, half, waveRange)).toEqual(false)
		expect(Proximity.WithinSquare(inf, F.zero, F.zero, F.zero, half, waveRange)).toEqual(false)
		expect(Proximity.WithinSquare(F.zero, -inf, F.zero, F.zero, half, waveRange)).toEqual(false)
	end)
end)
return true
