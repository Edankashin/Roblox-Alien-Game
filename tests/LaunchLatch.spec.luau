--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local LaunchLatch = require(Shared.LaunchLatch)
local F = require(script.Parent.Fixtures)

-- A latch over camp states named by the topic that carried them, and a log of what was drawn.
local function fresh()
	local latch = LaunchLatch.new() :: LaunchLatch.Latch<string>
	local drawn: { string } = {}
	local function offer(state: string)
		local now = latch.Offer(state)
		if now ~= nil then
			table.insert(drawn, now)
		end
	end
	local function release()
		local last = latch.Release()
		if last ~= nil then
			table.insert(drawn, last)
		end
	end
	return latch, drawn, offer, release
end

describe("LaunchLatch (the camp stays put while the ship lifts off)", function()
	it("an open latch draws every state at once", function()
		local latch, drawn, offer = fresh()
		expect(latch.IsHeld()).toEqual(false)
		offer("modules")
		offer("stations")
		expect(drawn[F.one]).toEqual("modules")
		expect(drawn[F.two]).toEqual("stations")
		expect(#drawn).toEqual(F.two)
	end)
	it("states offered under the latch are not drawn", function()
		local latch, drawn, offer = fresh()
		latch.Begin()
		expect(latch.IsHeld()).toEqual(true)
		offer("modules")
		offer("stations")
		offer("modules")
		expect(#drawn).toEqual(F.zero)
	end)
	it("opening it draws the last pending state once, and only once", function()
		local latch, drawn, offer, release = fresh()
		latch.Begin()
		offer("modules")
		offer("stations")
		release()
		expect(#drawn).toEqual(F.one)
		expect(drawn[F.one]).toEqual("stations")
		expect(latch.IsHeld()).toEqual(false)
		release()
		expect(#drawn).toEqual(F.one)
	end)
	it("opening it with nothing held back draws nothing", function()
		local latch, drawn, _, release = fresh()
		latch.Begin()
		release()
		expect(#drawn).toEqual(F.zero)
		expect(latch.IsHeld()).toEqual(false)
	end)
	it("an open latch draws again at once", function()
		local latch, drawn, offer, release = fresh()
		latch.Begin()
		offer("modules")
		release()
		offer("stations")
		expect(#drawn).toEqual(F.two)
		expect(drawn[F.two]).toEqual("stations")
	end)
	it("closing a closed latch keeps what it already holds", function()
		local latch, drawn, offer, release = fresh()
		latch.Begin()
		offer("modules")
		latch.Begin()
		release()
		expect(#drawn).toEqual(F.one)
		expect(drawn[F.one]).toEqual("modules")
	end)
	it("the next launch starts with nothing pending", function()
		local latch, drawn, offer, release = fresh()
		latch.Begin()
		offer("modules")
		release()
		latch.Begin()
		release()
		expect(#drawn).toEqual(F.one)
	end)
end)
return true
