--!strict
-- The B46 rigs: the data (data/Rigs, generated by tools/blocky/rigs.py) and the clip math the client's World.RigAnimator plays it by
-- (Shared/RigMath): every row names a real species and stays in its ranges, the clips are absolute and periodic, the flourish runs only in
-- its window, the face plate's frames follow the blink, glint and cycle timings, and the nearest-first budget picks at most its cap.
local Shared = game:GetService("ReplicatedStorage").Shared
local RigMath = require(Shared.RigMath)
local Rigs = require(Shared.data.Rigs)
local Species = require(Shared.data.Species)

local CLIPS = { bob = true, sway = true, flap = true, spin = true, wag = true, squash = true, pulse = true, orbit = true }
local MOVES = { hop = true, turn = true, flare = true, swish = true, pop = true, squash = true }
local AXES = { x = true, y = true, z = true }

local function clip(kind: any, amp: number, period: number, axis: any): any
	return { kind = kind, amp = amp, period = period, phase = 0, axis = axis }
end

describe("the data", function()
	it("has a row only for real species, with real kinds, axes and periods", function()
		local rows = 0
		for id, row in pairs(Rigs.Species) do
			rows += 1
			expect(Species.ById[id] ~= nil).toEqual(true)
			expect(row.height >= 2 and row.height <= 3.5).toEqual(true) -- B45: one band for every tier
			for _, part in ipairs(row.parts) do
				expect(#part.pivot).toEqual(3)
				expect(#part.clips > 0).toEqual(true)
				for _, c in ipairs(part.clips) do
					expect(CLIPS[c.kind]).toEqual(true)
					expect(AXES[c.axis]).toEqual(true)
					expect(c.period > 0).toEqual(true)
				end
			end
			local face = row.face
			expect(face ~= nil).toEqual(true)
			if face then
				expect(face.blinkEvery > 0).toEqual(true)
				expect(face.frames >= 3).toEqual(true)
				for _, i in ipairs(face.cycle) do
					expect(i < face.frames).toEqual(true)
				end
			end
			local flourish = row.flourish
			if flourish then
				expect(flourish.every > flourish.length).toEqual(true)
				for _, m in ipairs(flourish.moves) do
					expect(MOVES[m.kind]).toEqual(true)
					expect(m.at + m.length <= flourish.length + 1e-6).toEqual(true)
				end
			end
		end
		expect(rows >= 2).toEqual(true) -- the two pilots
	end)

	it("gives the Cosmic pilot far more motion than the Common one (B46)", function()
		local moop, raddis = Rigs.Species.Mossbop, Rigs.Species.Radish
		expect(#moop.parts + 1 >= 2).toEqual(true)
		expect(#raddis.parts + 1 >= 8).toEqual(true)
		expect(moop.flourish == nil).toEqual(true)
		expect(raddis.flourish ~= nil).toEqual(true)
		local face = raddis.face
		expect(face ~= nil and #face.cycle >= 6).toEqual(true)
	end)

	it("keeps the phone budget under the computer's", function()
		expect(Rigs.Budget.PhoneMaxAnimated <= Rigs.Budget.MaxAnimated).toEqual(true)
		expect(Rigs.Budget.FallbackClosed < Rigs.Budget.FallbackHalf).toEqual(true)
	end)
end)

describe("the clips", function()
	it("bob along the axis by its amplitude, a quarter period in", function()
		local pose = RigMath.NewPose()
		RigMath.Accumulate(pose, clip("bob", 0.1, 2, "y"), 0.5, 0)
		expect(pose.py).toBeClose(0.1, 1e-9)
		expect(pose.px).toEqual(0)
	end)

	it("are periodic and absolute (the same time gives the same pose)", function()
		for kind in pairs(CLIPS) do
			local a, b = RigMath.NewPose(), RigMath.NewPose()
			local c = clip(kind, if kind == "squash" or kind == "pulse" then 0.1 else 12, 1.6, "z")
			RigMath.Accumulate(a, c, 0.37, 0.2)
			RigMath.Accumulate(b, c, 0.37 + 1.6 * 3, 0.2)
			if kind ~= "spin" then
				expect(a.rz).toBeClose(b.rz, 1e-6)
			end
			expect(a.px).toBeClose(b.px, 1e-6)
			expect(a.sz).toBeClose(b.sz, 1e-6)
		end
	end)

	it("sway turns by its amplitude in degrees and flap stays on one side", function()
		local pose = RigMath.NewPose()
		RigMath.Accumulate(pose, clip("sway", 20, 4, "z"), 1, 0)
		expect(pose.rz).toBeClose(math.rad(20), 1e-9)
		for t = 0, 4, 0.1 do
			RigMath.Reset(pose)
			RigMath.Accumulate(pose, clip("flap", 30, 4, "z"), t, 0)
			expect(pose.rz >= -1e-9 and pose.rz <= math.rad(30) + 1e-9).toEqual(true)
		end
	end)

	it("spin goes once round a period, squash keeps a stretch against a squeeze, orbit keeps its radius", function()
		local pose = RigMath.NewPose()
		RigMath.Accumulate(pose, clip("spin", 360, 8, "y"), 4, 0)
		expect(pose.ry).toBeClose(math.pi, 1e-9)
		RigMath.Reset(pose)
		RigMath.Accumulate(pose, clip("squash", 0.1, 2, "y"), 0.5, 0)
		expect(pose.sy).toBeClose(1.1, 1e-9)
		expect(pose.sx).toBeClose(0.95, 1e-9)
		for t = 0, 3, 0.25 do
			RigMath.Reset(pose)
			RigMath.Accumulate(pose, clip("orbit", 0.2, 3, "y"), t, 0)
			expect(math.sqrt(pose.px ^ 2 + pose.pz ^ 2)).toBeClose(0.2, 1e-9)
		end
	end)
end)

describe("the flourish", function()
	local flourish: any = {
		every = 10,
		length = 2,
		moves = {
			{ part = "root", kind = "hop", amp = 0.4, axis = "y", at = 0, length = 1 },
			{ part = "root", kind = "turn", amp = 360, axis = "y", at = 0.5, length = 1.5 },
		},
	}

	it("runs only in its window, every `every` seconds", function()
		expect(RigMath.FlourishElapsed(flourish, 0.5, 0)).toBeClose(0.5, 1e-9)
		expect(RigMath.FlourishElapsed(flourish, 3, 0)).toEqual(-1)
		expect(RigMath.FlourishElapsed(flourish, 10.25, 0)).toBeClose(0.25, 1e-9)
	end)

	it("hops up and back down, and ends a full turn where it began", function()
		local pose = RigMath.NewPose()
		RigMath.AccumulateMove(pose, flourish.moves[1], 0.5)
		expect(pose.py).toBeClose(0.4, 1e-9)
		RigMath.Reset(pose)
		RigMath.AccumulateMove(pose, flourish.moves[1], 1)
		expect(math.abs(pose.py) < 1e-9).toEqual(true)
		RigMath.Reset(pose)
		RigMath.AccumulateMove(pose, flourish.moves[2], 2)
		expect(pose.ry).toBeClose(math.pi * 2, 1e-9)
		RigMath.Reset(pose)
		RigMath.AccumulateMove(pose, flourish.moves[2], 0.25) -- before the move's window
		expect(pose.ry).toEqual(0)
	end)
end)

describe("the face plate", function()
	local face: any = {
		part = "FacePlate",
		image = 0,
		frameWidth = 56,
		frameHeight = 28,
		columns = 4,
		frames = 13,
		open = 0,
		half = 1,
		closed = 2,
		glint = { 3, 4 },
		cycle = { 5, 6, 7, 8, 9, 10, 11, 12 },
		blinkEvery = 4,
		blinkLength = 0.3,
		glintEvery = 3,
		glintLength = 0.3,
		cycleFps = 8,
	}

	it("blinks half, closed, half at the top of its period", function()
		expect(RigMath.FaceFrame(face, 0.05, 0)).toEqual(1)
		expect(RigMath.FaceFrame(face, 0.15, 0)).toEqual(2)
		expect(RigMath.FaceFrame(face, 0.25, 0)).toEqual(1)
	end)

	it("glints small then big half a period after the blink, and cycles the iris otherwise", function()
		expect(RigMath.FaceFrame(face, 1.55, 0)).toEqual(3)
		expect(RigMath.FaceFrame(face, 1.65, 0)).toEqual(4)
		local frame = RigMath.FaceFrame(face, 2.2, 0)
		expect(frame >= 5 and frame <= 12).toEqual(true)
	end)

	it("lays the frames out left to right, four a row", function()
		local x, y = RigMath.FrameOffset(face, 5)
		expect(x).toEqual(56)
		expect(y).toEqual(28)
		expect(RigMath.FallbackShare(face, 2, 0.55, 0.15)).toEqual(0.15)
		expect(RigMath.FallbackShare(face, 7, 0.55, 0.15)).toEqual(1)
	end)
end)

describe("the budget", function()
	it("picks the nearest within the distance, at most the cap", function()
		local picked, order = {}, {}
		RigMath.PickNearest({ 30, 5, math.huge, 90, 12 }, 2, 80, picked, order)
		expect(picked[2]).toEqual(true)
		expect(picked[5]).toEqual(true)
		expect(picked[1]).toEqual(false)
		expect(picked[3]).toEqual(false)
		expect(picked[4]).toEqual(false)
	end)
end)
return true
