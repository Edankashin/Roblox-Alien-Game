--!strict
local Shared = game:GetService("ReplicatedStorage").Shared
local Countdown = require(Shared.Countdown)
local Config = require(Shared.data.Config)

local MINUTE = 60
local HOUR = 3600
local DAY = 86400

describe("Countdown.Short", function()
	it("reads the forms the What's on card shows", function()
		expect(Countdown.Short(1 * HOUR + 12 * MINUTE)).toEqual("1h 12m")
		expect(Countdown.Short(6 * MINUTE)).toEqual("6m")
		expect(Countdown.Short(2 * DAY + 4 * HOUR)).toEqual("2d 4h")
		expect(Countdown.Short(15 * DAY + 4 * HOUR)).toEqual("15d")
		expect(Countdown.Short(45)).toEqual("45s")
	end)
	it("rounds down at every size, so a countdown never reads ahead of the clock", function()
		expect(Countdown.Short(59.9)).toEqual("59s")
		expect(Countdown.Short(MINUTE)).toEqual("1m")
		expect(Countdown.Short(2 * MINUTE - 1)).toEqual("1m")
		expect(Countdown.Short(HOUR - 1)).toEqual("59m")
		expect(Countdown.Short(HOUR + MINUTE - 1)).toEqual("1h")
		expect(Countdown.Short(DAY - 1)).toEqual("23h 59m")
		expect(Countdown.Short(DAY + HOUR - 1)).toEqual("1d")
	end)
	it("drops a unit that is zero", function()
		expect(Countdown.Short(2 * HOUR)).toEqual("2h")
		expect(Countdown.Short(DAY)).toEqual("1d")
		expect(Countdown.Short(2 * DAY)).toEqual("2d")
		expect(Countdown.Short(1 * HOUR + 59 * MINUTE)).toEqual("1h 59m")
	end)
	it("keeps the hours up to Config.CountdownDaysOnlyFrom days and drops them from there", function()
		local from = Config.CountdownDaysOnlyFrom
		expect(Countdown.Short((from - 1) * DAY + 23 * HOUR)).toEqual(string.format("%dd 23h", from - 1))
		expect(Countdown.Short(from * DAY)).toEqual(string.format("%dd", from))
		expect(Countdown.Short(from * DAY + 23 * HOUR)).toEqual(string.format("%dd", from))
	end)
	it("reads a time already past, or no time at all, as zero", function()
		expect(Countdown.Short(0)).toEqual("0s")
		expect(Countdown.Short(-5)).toEqual("0s")
		expect(Countdown.Short(-math.huge)).toEqual("0s")
		expect(Countdown.Short(math.huge)).toEqual("0s")
		expect(Countdown.Short(0 / 0)).toEqual("0s")
	end)
end)

describe("Countdown.Clock", function()
	it("reads minutes and seconds", function()
		expect(Countdown.Clock(4 * MINUTE + 20)).toEqual("4:20")
		expect(Countdown.Clock(90)).toEqual("1:30")
		expect(Countdown.Clock(179)).toEqual("2:59")
		expect(Countdown.Clock(5)).toEqual("0:05")
	end)
	it("rounds up, so the last second reads 0:01 and only a time that is up reads 0:00", function()
		expect(Countdown.Clock(0.2)).toEqual("0:01")
		expect(Countdown.Clock(59.1)).toEqual("1:00")
		expect(Countdown.Clock(0)).toEqual("0:00")
	end)
	it("adds the hours from an hour up", function()
		expect(Countdown.Clock(HOUR)).toEqual("1:00:00")
		expect(Countdown.Clock(HOUR + 2 * MINUTE + 5)).toEqual("1:02:05")
	end)
	it("reads a time already past, or no time at all, as zero", function()
		expect(Countdown.Clock(-3)).toEqual("0:00")
		expect(Countdown.Clock(math.huge)).toEqual("0:00")
		expect(Countdown.Clock(0 / 0)).toEqual("0:00")
	end)
end)
return true
