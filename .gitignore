# video processing byproducts (large); sheets, transcripts and info are kept
media/tiktok/out/*/audio.wav
media/tiktok/out/*/frames/

# local tool cache
.cache/
__pycache__/

# Obsidian per-machine state (the vault notes themselves are tracked)
docs/vault/.obsidian/
docs/vault/.trash/

# Isolated worker checkouts (Agent worktrees); never committed
.claude/worktrees/
